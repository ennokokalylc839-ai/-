.step-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.step-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f5f9ff;
}

.step-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2b8aef, #6f5ef9);
  color: #ffffff;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.step-text {
  font-size: 28rpx;
  color: #1f2d3d;
  line-height: 1.6;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #6f5ef9;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #4a5872;
  line-height: 1.6;
}

.resource-group {
  margin-bottom: 24rpx;
}

.group-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #2b3a55;
}

.group-items {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.resource-card {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #f7f8ff;
}

.resource-info {
  flex: 1;
}

.resource-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d3d;
  margin-bottom: 8rpx;
}

.resource-desc {
  font-size: 26rpx;
  color: #6c7893;
  line-height: 1.6;
}

.resource-card .link-btn {
  align-self: center;
  background: linear-gradient(135deg, #2b8aef, #6f5ef9);
  color: #ffffff;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}
