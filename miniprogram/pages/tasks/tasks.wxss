.progress-overview {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.progress-rate {
  font-size: 52rpx;
  font-weight: 700;
  color: #2b8aef;
}

.progress-detail {
  font-size: 28rpx;
  color: #4a5872;
}

.progress-tip {
  font-size: 24rpx;
  color: #98a3bb;
}

.reset-btn {
  margin-top: 16rpx;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.task-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #f5f7ff;
}

.task-info {
  max-width: 520rpx;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d3d;
  margin-bottom: 8rpx;
}

.task-desc {
  font-size: 26rpx;
  color: #768399;
  line-height: 1.5;
}

.task-switch {
  transform: scale(0.9);
}

.add-task-section .add-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.link-btn {
  background: none;
  border: none;
  color: #2b8aef;
  font-size: 28rpx;
  padding: 0;
}

.add-form {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.add-input,
.add-textarea {
  width: 100%;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f7f9ff;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.add-input:focus,
.add-textarea:focus {
  border-color: rgba(43, 138, 239, 0.4);
}

.submit-btn {
  margin-top: 8rpx;
}

.add-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #9aa6be;
  line-height: 1.5;
}

.empty-state {
  text-align: center;
  color: #9aa6be;
  font-size: 26rpx;
  padding: 24rpx 0;
}
